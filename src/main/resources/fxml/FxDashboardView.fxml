<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import com.netpulse.ui.SpeedometerView?>
<?import com.netpulse.ui.TrafficChartView?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.netpulse.ui.FxDashboardController" stylesheets="@../css/styles.css" styleClass="dashboard" focusTraversable="true">
    <top>
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="header">
            <Label text="N" styleClass="brand-mark"/>
            <VBox spacing="2"><Label text="NetPulse" styleClass="brand-title"/><Label text="NETWORK MONITOR" styleClass="eyebrow"/></VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <VBox alignment="CENTER_RIGHT" spacing="5" minWidth="120" maxWidth="390">
                <Label fx:id="connectionStatus" text="Link unknown" styleClass="connection-badge"/>
                <Label fx:id="headerAdapter" text="Finding an adapter…" styleClass="muted" maxWidth="390"/>
            </VBox>
        </HBox>
    </top>
    <center>
        <ScrollPane fx:id="dashboardScroll" fitToWidth="true" hbarPolicy="NEVER" styleClass="dashboard-scroll">
            <content>
                <VBox spacing="14" styleClass="content">
                    <VBox spacing="4"><Label text="Your network, at a glance." styleClass="page-title"/>
                        <Label text="Live adapter traffic and an on-demand internet benchmark." styleClass="muted" wrapText="true"/>
                    </VBox>
                    <!-- Wrap columns at narrow widths; keep each column at its own content height. -->
                    <FlowPane fx:id="columns" hgap="20" vgap="20" alignment="TOP_LEFT" rowValignment="TOP">
                        <VBox fx:id="monitoringColumn" spacing="12" minWidth="0" maxHeight="-Infinity">
                            <HBox spacing="16">
                                <VBox fx:id="downloadCard" spacing="5" minWidth="0" styleClass="card,download-card">
                                    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="↓" styleClass="direction,download-ink"/><Label text="Download" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="LIVE" styleClass="eyebrow"/></HBox>
                                    <SpeedometerView fx:id="downloadGauge"/>
                                </VBox>
                                <VBox fx:id="uploadCard" spacing="5" minWidth="0" styleClass="card,upload-card">
                                    <HBox alignment="CENTER_LEFT" spacing="8"><Label text="↑" styleClass="direction,upload-ink"/><Label text="Upload" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label text="LIVE" styleClass="eyebrow"/></HBox>
                                    <SpeedometerView fx:id="uploadGauge"/>
                                </VBox>
                            </HBox>
                            <Label fx:id="monitoringStatus" text="Waiting for measurements" styleClass="muted" wrapText="true"/>
                            <TrafficChartView fx:id="trafficChart"/>
                            <HBox spacing="18" styleClass="card,session-card">
                                <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="0"><Label text="SESSION DOWNLOADED" styleClass="eyebrow"/><Label fx:id="sessionDownload" text="0.00 MB" styleClass="total,download-ink" wrapText="true"/></VBox>
                                <VBox spacing="5" HBox.hgrow="ALWAYS" minWidth="0"><Label text="SESSION UPLOADED" styleClass="eyebrow"/><Label fx:id="sessionUpload" text="0.00 MB" styleClass="total,upload-ink" wrapText="true"/></VBox>
                            </HBox>
                            <VBox spacing="7" styleClass="card">
                                <HBox alignment="CENTER_LEFT" spacing="10"><Label text="Active adapter" styleClass="section-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="identification" text="—" styleClass="muted" wrapText="true"/></HBox>
                                <Label fx:id="adapterName" text="—" styleClass="adapter-name" wrapText="true"/>
                                <GridPane hgap="18" vgap="5">
                                    <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                                    <Label text="INTERFACE" styleClass="eyebrow"/><Label text="MAC ADDRESS" styleClass="eyebrow" GridPane.columnIndex="1"/>
                                    <Label fx:id="interfaceName" text="—" wrapText="true" GridPane.rowIndex="1"/><Label fx:id="macAddress" text="—" wrapText="true" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                                </GridPane>
                                <Label text="Link status describes the adapter. Internet connectivity is not verified." styleClass="fine-print" wrapText="true"/>
                            </VBox>
                        </VBox>
                        <VBox fx:id="benchmarkColumn" spacing="10" styleClass="card,benchmark-card" minWidth="0" maxHeight="-Infinity">
                            <VBox spacing="5"><Label text="Ookla benchmark" styleClass="panel-title"/><Label text="Measure internet speed with the official CLI." styleClass="muted" wrapText="true"/></VBox>
                            <HBox spacing="9"><Button fx:id="startTest" text="Start Speed Test" onAction="#startSpeedTest" styleClass="primary-button" HBox.hgrow="ALWAYS" maxWidth="Infinity"/><Button fx:id="cancelTest" text="Cancel" onAction="#cancelSpeedTest" disable="true"/></HBox>
                            <HBox spacing="9" alignment="CENTER_LEFT"><ProgressIndicator fx:id="testProgress" progress="-1" visible="false" managed="false" prefWidth="18" prefHeight="18" minWidth="18" minHeight="18" maxWidth="18" maxHeight="18"/><Label fx:id="testStatus" text="Ready to run an Ookla speed test" wrapText="true" styleClass="test-status" HBox.hgrow="ALWAYS" minWidth="0"/></HBox>
                            <HBox alignment="CENTER_LEFT" spacing="8"><Button fx:id="chooseCli" text="Choose CLI…" onAction="#chooseExecutable" styleClass="link-button"/><Label fx:id="cliLocation" text="Uses PATH by default" styleClass="fine-print" minWidth="0"/></HBox>
                            <Separator/>
                            <Label text="LATEST SUCCESSFUL RESULT" styleClass="eyebrow"/>
                            <GridPane hgap="16" vgap="18">
                                <columnConstraints><ColumnConstraints percentWidth="50"/><ColumnConstraints percentWidth="50"/></columnConstraints>
                                <VBox spacing="3"><Label text="DOWNLOAD · Mbps" styleClass="eyebrow"/><Label fx:id="benchmarkDownload" text="—" styleClass="result-value,download-ink"/></VBox>
                                <VBox spacing="3" GridPane.columnIndex="1"><Label text="UPLOAD · Mbps" styleClass="eyebrow"/><Label fx:id="benchmarkUpload" text="—" styleClass="result-value,upload-ink"/></VBox>
                                <VBox spacing="3" GridPane.rowIndex="1"><Label text="IDLE PING" styleClass="eyebrow"/><Label fx:id="idlePing" text="—" styleClass="latency-value"/></VBox>
                                <VBox spacing="3" GridPane.rowIndex="1" GridPane.columnIndex="1"><Label text="JITTER" styleClass="eyebrow"/><Label fx:id="jitter" text="—" styleClass="latency-value"/></VBox>
                            </GridPane>
                            <Separator/>
                            <VBox spacing="5"><Label text="PACKET LOSS" styleClass="eyebrow"/><Label fx:id="packetLoss" text="—"/></VBox>
                            <VBox spacing="5"><Label text="SERVER" styleClass="eyebrow"/><Label fx:id="server" text="—" wrapText="true"/></VBox>
                            <VBox spacing="5"><Label text="ISP" styleClass="eyebrow"/><Label fx:id="isp" text="—" wrapText="true"/></VBox>
                            <VBox spacing="5"><Label text="COMPLETED" styleClass="eyebrow"/><Label fx:id="completedAt" text="—" wrapText="true"/></VBox>
                            <Label text="Tests use internet data. Ookla terms must be reviewed and accepted in the CLI before testing." styleClass="fine-print" wrapText="true"/>
                        </VBox>
                    </FlowPane>
                    <Label text="NETPULSE  /  Live traffic uses decimal Mbps and MB/s. Session totals reset when the app closes." styleClass="fine-print" wrapText="true"/>
                </VBox>
            </content>
        </ScrollPane>
    </center>
</BorderPane>
